# Copiar a terraform.tfvars y rellenar con valores reales.
# No commitear terraform.tfvars (contiene secretos).

aws_region   = "us-east-1"
aws_account_id = "123456789012"
environment  = "staging"

datadog_site = "datadoghq.com"
# datadog_api_key y datadog_app_key: usar variables de entorno o -var en plan/apply.
# Ejemplo con variables de entorno:
#   $env:DATADOG_API_KEY="..."; $env:DATADOG_APP_KEY="..."
#   terraform plan -var="datadog_api_key=$env:DATADOG_API_KEY" -var="datadog_app_key=$env:DATADOG_APP_KEY"

# Opcional: otro sitio Datadog (EU)
# datadog_site             = "datadoghq.eu"
# datadog_aws_principal_account_id = "..."  # Ver docs Datadog por sitio
