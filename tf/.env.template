# Datadog credentials - Copy this file to .env and fill in your actual values
# DO NOT COMMIT THE .env FILE TO THE REPOSITORY

# Datadog API Key (from your Datadog account)
DD_API_KEY=your_datadog_api_key_here

# Datadog Application Key (from your Datadog account)
DD_APP_KEY=your_datadog_app_key_here

# AWS Account ID
AWS_ACCOUNT_ID=your_aws_account_id_here

# AWS Region
AWS_REGION=us-east-1
