              "lti-project-backend-sg"
            ],
            "source_dest_check": true,
            "spot_instance_request_id": "",
            "subnet_id": "subnet-082e0e2c89c852dce",
            "tags": {
              "Name": "lti-project-backend"
            },
            "tags_all": {
              "Name": "lti-project-backend"
            },
            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\r\nyum update -y\r\nsudo yum install -y docker\r\n\r\n# Iniciar el servicio de Docker\r\nsudo service docker start\r\n\r\n# Instalar el agente Datadog\r\nDD_API_KEY=\"7c2ac72242b68b629530d9717f89f463\" DD_SITE=\"datadoghq.com\" bash -c \"$(curl -L https://s3.amazonaws.com/dd-agent/scripts/install_script.sh)\"\r\n\r\n# Configurar el agente Datadog para Docker\r\nsudo tee /etc/datadog-agent/conf.d/docker.d/conf.yaml \u003c\u003cEOF\r\ninit_config:\r\n\r\ninstances:\r\n  - url: \"unix://var/run/docker.sock\"\r\n    new_tag_names: true\r\n    collect_container_size: true\r\n    collect_container_count: true\r\n    collect_volume_count: true\r\n    collect_images_stats: true\r\n    collect_image_size: true\r\n    collect_disk_stats: true\r\nEOF\r\n\r\n# Reiniciar el agente Datadog\r\nsudo systemctl restart datadog-agent\r\n\r\n# Descargar y descomprimir el archivo backend.zip desde S3\r\naws s3 cp s3://ai4devs-project-code-bucket/backend.zip /home/ec2-user/backend.zip\r\nunzip /home/ec2-user/backend.zip -d /home/ec2-user/\r\n\r\n# Construir la imagen Docker para el backend\r\ncd /home/ec2-user/backend\r\nsudo docker build -t lti-backend .\r\n\r\n# Ejecutar el contenedor Docker\r\nsudo docker run -d -p 8080:8080 lti-backend\r\n\r\n# Timestamp to force update\r\necho \"Timestamp: 2025-09-29T04:32:25Z\"\r\n",
            "user_data_base64": null,
            "user_data_replace_on_change": false,
            "volume_tags": null,
            "vpc_security_group_ids": [
              "sg-032682ccf07a48a5b"
